{
  "name": "@nanachi/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Daemon do Nanachi Remote: Fastify + WebSocket + SQLite + CLI de pareamento.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "pair": "tsx src/cli.ts pair",
    "devices": "tsx src/cli.ts devices",
    "revoke": "tsx src/cli.ts revoke",
    "vapid": "tsx src/cli.ts vapid",
    "autostart": "tsx src/cli.ts autostart",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "ws": "^8.22.1"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.100.0",
    "@agentclientprotocol/codex-acp": "^2.5.0",
    "@agentclientprotocol/sdk": "^2.4.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@fastify/cors": "^11.4.0",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.6",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "5.10.4",
    "extract-zip": "^2.0.1",
    "fastify": "^5.12.8",
    "web-push": "^3.6.7"
  }
}
