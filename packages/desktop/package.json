{
  "name": "@nanachi/desktop",
  "productName": "Nanachi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nanachi Desktop: Electron shell for Windows that hosts the daemon, the tray and the control panel.",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p installer/ui/tsconfig.json && tsc -p src/control/tsconfig.json",
    "test": "vitest run",
    "build:desktop": "tsc -p tsconfig.build.json && tsx scripts/build-preload.ts && tsx scripts/build-ui.ts && tsx scripts/build-control.ts",
    "dev": "npm run build:desktop && electron .",
    "stage": "tsx scripts/stage.ts",
    "package": "tsx scripts/package.ts"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "~0.28.0",
    "extract-zip": "^2.0.1",
    "i18next": "^26.7.1",
    "lucide-react": "^1.68.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.1.12",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "yazl": "^3.3.1"
  }
}
